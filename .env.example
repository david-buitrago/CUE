DATABASE_URL=postgresql://cue_app:replace-with-the-cue-password@100.96.44.11:5434/cue
INSIGHTS_PROVIDER=opencode
OPENCODE_API_KEY=replace-with-your-opencode-go-api-key
OPENCODE_MODEL=glm-5.3
# To use the private Ollama endpoint instead, set INSIGHTS_PROVIDER=ollama.
# OLLAMA_BASE_URL=http://your-private-ollama-host:11434
# OLLAMA_MODEL=qwen3:4b
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
# Local path to a 16-bit PCM, 16 kHz WAV file with THEM on the left channel
# and YOU on the right channel. This is for development fixture replay only.
CUE_AUDIO_FIXTURE_PATH=/absolute/path/to/cue-you-them-fixture.wav
